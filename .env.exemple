# Ambiente
DEBUG=True
SECRET_KEY=troque-por-uma-chave-secreta-segura

# Hosts separados por vírgula
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Desenvolvimento: exibe os e-mails no terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para envio real com SMTP, altere o backend para:
# django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Use um valor longo e imprevisível
WEBHOOK_TOKEN=troque-por-um-token-seguro